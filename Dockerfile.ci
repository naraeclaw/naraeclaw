# Dockerfile.ci — CI/release image using pre-built binaries.
# Used by release workflows to skip the ~60 min Rust compilation.
# The main Dockerfile is still used for local dev builds.

# ── Runtime (Distroless) ─────────────────────────────────────
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:8f960b7fc6a5d6e28bb07f982655925d6206678bd9a6cde2ad00ddb5e2077d78

ARG TARGETARCH

# Copy the pre-built binary for this platform (amd64 or arm64)
COPY bin/${TARGETARCH}/naraeclaw /usr/local/bin/naraeclaw

# Runtime directory structure and default config
COPY --chown=65534:65534 naraeclaw-data/ /naraeclaw-data/

ENV LANG=C.UTF-8
ENV NARAECLAW_WORKSPACE=/naraeclaw-data/workspace
ENV HOME=/naraeclaw-data
ENV NARAECLAW_GATEWAY_PORT=42617

WORKDIR /naraeclaw-data
USER 65534:65534
EXPOSE 42617
ENTRYPOINT ["naraeclaw"]
CMD ["gateway"]
