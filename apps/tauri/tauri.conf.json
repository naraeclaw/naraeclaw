{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "NaraeClaw",
  "version": "0.6.9",
  "identifier": "ai.naraeclaw.desktop",
  "build": {
    "beforeDevCommand": "cd ../../web && npm run dev",
    "beforeBuildCommand": "cd ../../web && npm run build",
    "devUrl": "http://localhost:5173/",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "NaraeClaw",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:42617 ws://127.0.0.1:42617; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://127.0.0.1:42617 data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/naraeclaw"
    ]
  }
}
